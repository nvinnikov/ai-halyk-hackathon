# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local agent config
.claude/

# Оба набора (публичный и закрытый) распакованы в dataset/ и собираются из
# него `make public-archive` / `make private-archive` — архивы в git не нужны.
*.zip
# Маркер формата упаковки архива (рядом с ним, тоже не в git)
*.packfmt

# Артефакты прогонов: кэш текста PDF пересобирается `make extract`
solution/docs_text.json
out/

# macOS
.DS_Store
# Исключение: закрытый набор хранится в git РАСПАКОВАННЫМ КАТАЛОГОМ целиком,
# включая подсадный мусор (Thumbs.db, ~$lock.docx, .DS_Store) — это часть
# задания, конвейер обязан сам отбраковывать такие файлы, а не полагаться на
# то, что их нет на диске. Общее правило выше для этого каталога отключается
# точечно; публичный набор аналогичного мусора в git не несёт (см. README).
!dataset/agentic-bank-private/**/.DS_Store

# Ключи API и рабочие артефакты пайплайна
.env
work/
