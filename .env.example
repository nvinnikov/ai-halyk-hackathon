# Реквизиты и настройки прогона. Скопировать в .env и заполнить своими
# значениями: `cp .env.example .env`.
#
# Файл .env читает run.sh (`set -a; source .env`) — сам код его не парсит и
# берёт всё из окружения процесса. В git .env не хранится (.gitignore); этот
# пример хранится и НЕ должен содержать настоящих ключей.

# --- Ключи провайдеров ------------------------------------------------------
# Нужен ключ того провайдера, который выбран в LLM_PROVIDER. Второй можно не
# задавать; держать оба полезно как аварийный путь, если один недоступен.
# Значения подставляются как есть: run.sh делает `source`, поэтому строки с
# пробелами обязаны быть в кавычках, а угловых скобок-плейсхолдеров тут быть не
# может — оболочка прочитает их как перенаправление и запуск упадёт.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Выбор модели -----------------------------------------------------------
# anthropic | gemini. Прогон печатает провайдера и модель второй строкой, сразу
# после dataset_hash, — если там не то, что ожидали, значит .env не прочитался.
# Кассета eval/cassette/ снята под gemini: ключ кэша зависит от модели, поэтому
# с другим провайдером офлайн-прогон промахнётся мимо неё целиком.
LLM_PROVIDER=gemini

# Пауза между вызовами Gemini в миллисекундах; 0 или пусто — выключено.
# Троттл глобальный на процесс, поэтому SOLVE_WORKERS его не обходит. Значение
# ниже держит частоту у границы бесплатного тарифа: 429-шторм дороже ожидания.
GEMINI_MIN_INTERVAL_MS=5000

# --- Реквизиты отправки -----------------------------------------------------
# Попадают в out/submission.json. Пустые значения прогон не роняют, но печатает
# ALARM submission_meta_empty — проверяйте эту строку перед отправкой.
# Кавычки обязательны: в названии команды бывает пробел.
TEAM_NAME=""
CONTACT_EMAIL=""

# Необязательное: имя модели в submission.json. По умолчанию подставляется
# фактически использованная.
# MODEL_NAME=

# --- Необязательные тумблеры ------------------------------------------------
# Потолок расходов на LLM в долларах (по умолчанию 50). При превышении вызовы
# падают BudgetExhausted, прогон продолжается по лестнице фолбэков.
# LLM_BUDGET_USD=50

# Размер пула потоков документного слоя (по умолчанию 4). Пропускную способность
# не поднимает — ограничитель здесь троттл LLM, — но влияет на параллелизм чтения.
# SOLVE_WORKERS=4

# 1 — запретить сетевые вызовы: только кассета и work/llm_cache, промах обоих
# это ошибка. Ставится точечно в командах, в .env обычно не нужен.
# LLM_OFFLINE=1

# 1 — снять снапшот отправки даже если прогон опознан как публичный. Аварийный
# обход блокировки make submit; в .env ему не место — задавать в самой команде
# (`SUBMIT_FORCE=1 make submit`), чтобы обход не пережил тот случай, ради
# которого понадобился.
# SUBMIT_FORCE=1
